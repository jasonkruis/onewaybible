---
layout: base.njk
pagination:
  data: topics
  size: 1
  alias: topic
permalink: "/topics/{{ topic.slug }}/"
eleventyComputed:
  title: "{{ topic.name }}"
  description: "{{ topic.blurb }}"
---
<div class="library">
  <div class="wrap wrap--wide library__inner">

    {# ---- Left rail: all topics ---- #}
    <nav class="rail" aria-label="Topics">
      <p class="rail__label">Topics</p>
      <ul class="rail__list">
        {% for t in topics %}
        <li>
          <a class="rail__link {% if t.slug == topic.slug %}is-current{% endif %}"
             href="/topics/{{ t.slug }}/"
             {% if t.slug == topic.slug %}aria-current="page"{% endif %}>
            <span class="rail__name">{{ t.name }}</span>
            <span class="rail__count">{{ collections.resources | countForTopic(t.slug) }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>

    {# ---- Right panel: this topic's resources, grouped by type ---- #}
    <section class="panel" aria-label="{{ topic.name }} resources">
      <header class="panel__head">
        <h1 class="panel__title">{{ topic.name }}</h1>
        {% if topic.blurb %}<p class="panel__blurb">{{ topic.blurb }}</p>{% endif %}
      </header>

      {% set groups = collections.resources | resourcesForTopic(topic.slug, types) %}
      {% if groups.length %}
        {% for group in groups %}
        <div class="group">
          <p class="group__label">{{ group.label }}</p>
          <ul class="reslist">
            {% for item in group.items %}
            <li class="reslist__item">
              {% if item.data.type == "writing" or not item.data.type %}
                <a class="reslist__link" href="{{ item.url }}">
                  <span class="reslist__title">{{ item.data.title }}</span>
                  {% if item.data.description %}<span class="reslist__blurb">{{ item.data.description }}</span>{% endif %}
                </a>
              {% else %}
                {# audio / video / slides / graphic: link out or to the file #}
                <a class="reslist__link" href="{{ item.data.link or item.url }}"
                   {% if item.data.link %}target="_blank" rel="noopener"{% endif %}>
                  <span class="reslist__title">{{ item.data.title }}</span>
                  {% if item.data.description %}<span class="reslist__blurb">{{ item.data.description }}</span>{% endif %}
                </a>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      {% else %}
        <p class="panel__empty">Nothing here yet. Resources on this topic will appear as they&rsquo;re added.</p>
      {% endif %}
    </section>

  </div>
</div>
