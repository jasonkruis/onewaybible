---
layout: base.njk
---
<article class="article">
  <div class="wrap">
    <a class="backlink" href="/">Library</a>

    <header class="article__head">
      {% if eyebrow %}<p class="article__eyebrow">{{ eyebrow }}</p>{% endif %}
      <h1 class="article__title">{{ title }}</h1>
    </header>

    <div class="prose">
      {{ content | safe }}
    </div>

    <footer class="filed">
      {% if topic %}
      <span class="filed__row">
        <span class="filed__label">Topic</span>
        <a class="filed__tag filed__tag--topic" href="/topics/{{ topic | slug }}/">{{ topic }}</a>
      </span>
      {% endif %}
      {% if tags %}
      <span class="filed__row">
        <span class="filed__label">Tags</span>
        {% for t in tags %}
          <a class="tag" href="/tags/{{ t | slug }}/">{{ t }}</a>
        {% endfor %}
      </span>
      {% endif %}
    </footer>
  </div>
</article>
